{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "height": 15,
    "width": 30,
    "padding": {
      "top": 5,
      "left": 3
    }
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 17
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌────────────────────── Hardware ──────────────────────┐"
    },
    {
      "type": "host",
      "key": "\u001b[90m│\u001b[32m 󰌢  PC",
      "keyColor": "green"
    },
    {
      "type": "cpu",
      "key": "\u001b[90m│\u001b[32m 󰻠  CPU",
      "keyColor": "green",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "\u001b[90m│\u001b[32m 󰍹  GPU",
      "keyColor": "green",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "\u001b[90m│\u001b[32m 󰑭  Memory",
      "keyColor": "green"
    },
    {
      "type": "swap",
      "key": "\u001b[90m│\u001b[32m 󰓡  Swap",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "key": "\u001b[90m│\u001b[32m 󰋊  Disk",
      "keyColor": "green",
      "folders": "/",
      "format": "{size-used} / {size-total} ({size-percentage}) · {filesystem}"
    },
    {
      "type": "battery",
      "key": "\u001b[90m│\u001b[31m 󰁹  Battery",
      "keyColor": "red"
    },
    {
      "type": "poweradapter",
      "key": "\u001b[90m│\u001b[31m 󰚥  Adapter",
      "keyColor": "red"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└──────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌────────────────────── Software ──────────────────────┐"
    },
    {
      "type": "os",
      "key": "\u001b[90m│\u001b[33m 󰣇  OS",
      "keyColor": "yellow"
    },
    {
      "type": "kernel",
      "key": "\u001b[90m│\u001b[33m 󰌽  Kernel",
      "keyColor": "yellow"
    },
    {
      "type": "bios",
      "key": "\u001b[90m│\u001b[33m 󰖡  BIOS",
      "keyColor": "yellow",
      "format": "{release}"
    },
    {
      "type": "packages",
      "key": "\u001b[90m│\u001b[33m 󰏗  Packages",
      "keyColor": "yellow"
    },
    {
      "type": "shell",
      "key": "\u001b[90m│\u001b[33m 󰞷  Shell",
      "keyColor": "yellow"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└──────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌────────────────────── Desktop ───────────────────────┐"
    },
    {
      "type": "lm",
      "key": "\u001b[90m│\u001b[34m 󰍁  Login",
      "keyColor": "blue"
    },
    {
      "type": "wm",
      "key": "\u001b[90m│\u001b[34m 󱂬  WM",
      "keyColor": "blue"
    },
    {
      "type": "terminal",
      "key": "\u001b[90m│\u001b[34m 󰆍  Terminal",
      "keyColor": "blue"
    },
    {
      "type": "display",
      "key": "\u001b[90m│\u001b[36m 󰍹  Display",
      "keyColor": "cyan",
      "compactType": "original-with-refresh-rate"
    },
    {
      "type": "brightness",
      "key": "\u001b[90m│\u001b[36m 󰃟  Brightness",
      "keyColor": "cyan"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└──────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────── Environment ─────────────────────┐"
    },
    {
      "type": "theme",
      "key": "\u001b[90m│\u001b[34m 󰉦  Theme",
      "keyColor": "blue"
    },
    {
      "type": "icons",
      "key": "\u001b[90m│\u001b[34m 󰀻  Icons",
      "keyColor": "blue"
    },
    {
      "type": "font",
      "key": "\u001b[90m│\u001b[34m 󰛖  Font",
      "keyColor": "blue"
    },
    {
      "type": "terminalfont",
      "key": "\u001b[90m│\u001b[34m 󰛖  Term Font",
      "keyColor": "blue"
    },
    {
      "type": "cursor",
      "key": "\u001b[90m│\u001b[34m 󰇀  Cursor",
      "keyColor": "blue"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└──────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌─────────────────────── System ───────────────────────┐"
    },
    {
      "type": "command",
      "key": "\u001b[90m│\u001b[35m 󰃭  Age",
      "keyColor": "magenta",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    {
      "type": "uptime",
      "key": "\u001b[90m│\u001b[35m 󰔛  Uptime",
      "keyColor": "magenta"
    },
    {
      "type": "datetime",
      "key": "\u001b[90m│\u001b[35m 󰥔  Date",
      "keyColor": "magenta"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└──────────────────────────────────────────────────────┘"
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}
