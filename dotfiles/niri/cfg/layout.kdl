layout {
    gaps 8
    background-color "transparent"
    center-focused-column "never"
    always-center-single-column

    preset-column-widths {
        proportion 0.33333
        proportion 0.4
        proportion 0.5
        proportion 0.6
        proportion 0.66667
    }

    default-column-width {
        proportion 0.5
    }

    focus-ring {
        width 3
        active-color "#3584e4"
        inactive-color "#505050"
    }

    border {
        off
    }

    struts {
    }
}
