blur {
    passes 2
    offset 2.5
    noise 0.03
    saturation 1.0
}

window-rule {
    geometry-corner-radius 6
    clip-to-geometry true
}

// Keep Noctalia's wallpaper stationary while switching workspaces.
layer-rule {
    match namespace="^noctalia-wallpaper"
    place-within-backdrop true
}

// Avoid a second shadow around workspaces over the shell wallpaper.
overview {
    workspace-shadow {
        off
    }
}
