window-rule {
    match is-window-cast-target=true

    focus-ring {
        active-color "#e01b24"
        inactive-color "#7d0d2d"
    }
}

window-rule {
    match app-id=r#"^QQ$"#
    // Policy-installed Chrome WebAppIds: Cinny, Discord, Oopz, Rust Zulip, Telegram.
    match app-id=r#"^chrome-(bcngdmpegpihnheapppgoniglphkpfhm|pliiebkcmokkgndfalahlmimanmbjlab|hgbpnngkjfhcnkdakkemekcknmjdhfkc|doaomjibpoemjdfcplalmkmdhgaadood|nigookeodlehlnjcpdfifmophdcbjoma)-Default$"#

    open-on-workspace "main"
    open-focused true
}

window-rule {
    match app-id=r#"^QQ$"# title=r#"聊天记录$"#

    open-floating true
}

window-rule {
    match app-id=r#"^kitty$"#
    match app-id=r#"^dev\.zed\.Zed$"#

    open-on-workspace "dev"
    open-maximized true
}

window-rule {
    match app-id=r#"(?i)^google-chrome(?:-stable)?$"#

    open-on-workspace "browser"
    open-focused true
    open-maximized-to-edges true
}

window-rule {
    match app-id=r#"^steam$"#
    exclude app-id=r#"^steam$"# title=r#"^notificationtoasts_\d+_desktop$"#

    // STS2
    match app-id=r#"(?i)^slay(?:[\s_-]*the)?[\s_-]*spire[\s_-]*2$"#
    match title=r#"(?i)^slay the spire 2(?:\s|$)"#

    // HMCL
    match app-id=r#"(?i)^(hmcl|org\.jackhuang\.hmcl(?:\..*)?)$"#
    match app-id=r#"^java$"# title=r#"^HMCL(?:\s|$)"#

    // Endfield cloud game
    match app-id=r#"^waydroid\.com\.hypergryph\.cloud\.endfield$"#

    open-on-workspace "game"
    open-focused true
}

// Steam renders friend and game activity notifications as separate toplevels.
window-rule {
    match app-id=r#"^steam$"# title=r#"^notificationtoasts_\d+_desktop$"#

    open-floating true
    open-focused false
    default-floating-position x=16 y=16 relative-to="bottom-right"
}

window-rule {
    match app-id=r#"^chrome-jfmfhdlohbopnadjpiopnfkncjkjaihl-Default$"#

    open-on-workspace "game"
    open-focused true
    open-maximized true
}

window-rule {
    match app-id=r#"^(wps|et|wpp)$"# title=r#"^(wps|et|wpp)$"#

    open-floating true
}

// Sizes
window-rule {
    // Telegram
    match app-id=r#"^chrome-nigookeodlehlnjcpdfifmophdcbjoma-Default$"#

    default-column-width { proportion 0.33333; }
}
