window-rule {
    match app-id=r#"^kitty$"#

    open-on-workspace "dev"
    open-maximized true
}

// Dense, multi-pane applications benefit from a wider initial column.
window-rule {
    match app-id=r#"^QQ$"#
    match app-id=r#"(?i)^(org\.kde\.)?dolphin$"#
    match app-id=r#"(?i)^(org\.qbittorrent\.)?qbittorrent$"#
    match app-id=r#"^(wps|et|wpp)$"#

    // WPS exposes font selectors as XWayland toplevels instead of popups.
    exclude app-id=r#"^(wps|et|wpp)$"# title=r#"^(wps|et|wpp)$"#

    default-column-width { proportion 0.66667; }
}

window-rule {
    match app-id=r#"^AlgerMusicPlayer$"#

    default-column-width { proportion 0.6; }
}

window-rule {
    match app-id=r#"^chrome-web\.telegram\.org__k_-Default$"#

    default-column-width { proportion 0.4; }
}

window-rule {
    match is-window-cast-target=true

    focus-ring {
        active-color "#e01b24"
        inactive-color "#7d0d2d"
    }
}

window-rule {
    match app-id=r#"^firefox$"#
    exclude title="^Picture-in-Picture$"

    open-on-workspace "browser"
    open-focused true
    open-maximized true
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// WPS exposes font selectors as XWayland toplevels instead of popups.
window-rule {
    match app-id=r#"^(wps|et|wpp)$"# title=r#"^(wps|et|wpp)$"#

    open-floating true
}

window-rule {
    match app-id=r#"^steam$"#
    exclude app-id=r#"^steam$"# title=r#"^notificationtoasts_\d+_desktop$"#

    // STS2
    match app-id=r#"(?i)^slay(?:[\s_-]*the)?[\s_-]*spire[\s_-]*2$"#
    match title=r#"(?i)^slay the spire 2(?:\s|$)"#

    // HMCL
    match app-id=r#"(?i)^(hmcl|org\.jackhuang\.hmcl(?:\..*)?)$"#
    match app-id=r#"^java$"# title=r#"^HMCL(?:\s|$)"#

    // Endfield cloud game
    match app-id=r#"^waydroid\.com\.hypergryph\.cloud\.endfield$"#

    open-on-workspace "game"
    open-focused true
}

// Steam renders friend and game activity notifications as separate toplevels.
window-rule {
    match app-id=r#"^steam$"# title=r#"^notificationtoasts_\d+_desktop$"#

    open-floating true
    open-focused false
    default-floating-position x=16 y=16 relative-to="bottom-right"
}

window-rule {
    match app-id=r#"^chrome-cg\.163\.com__-Default$"#

    open-on-workspace "game"
    open-focused true
    open-maximized true
}
