#!/usr/bin/env sh

# Usage: focus-or-launch <app-id> <command> [argument...]
#
# Focus the first matching window (even on another workspace), or run the
# command when no window with the requested app-id exists.
set -eu

app_id="$1"
shift

window_id="$(
    niri msg -j windows \
        | jq -r --arg app_id "$app_id" \
            '[.[] | select(.app_id == $app_id) | .id] | first // empty'
)"

if [ -n "$window_id" ]; then
    exec niri msg action focus-window --id "$window_id"
fi

exec "$@"
